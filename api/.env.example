# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/reown_db?schema=public"

# Redis Cache & Queues
REDIS_URL="redis://localhost:6379"

# Server Port
PORT=3000

# SMTP Email Configuration (for OTP Emails)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
SMTP_FROM="noreply@usereown.com"

# Paystack API Keys (Escrow Payments)
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."

# Prembly API Keys (NIN/BVN Verification)
PREMBLY_APP_ID="your_prembly_app_id"
PREMBLY_SECRET_KEY="your_prembly_secret_key"

# JWT Secret
JWT_SECRET="super_secret_jwt_key_change_in_production"
